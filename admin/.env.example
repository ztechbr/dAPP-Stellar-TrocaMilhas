# Copie para .env e preencha. Nunca versione o .env (já está no .gitignore).
# FLASK_SECRET: 32+ caracteres aleatórios, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ADMIN_PASSWORD_HASH: python -c "from werkzeug.security import generate_password_hash as g; print(g(input('Senha: ')))"
# CONTRACT_ID: preenchido automaticamente por "compile.bat deploy".
# SOURCE_ALIAS: alias da chave na Stellar CLI que assina as distribuições.
# COOKIE_SECURE: true quando o painel estiver atrás de HTTPS.
FLASK_SECRET=generate-at-least-32-random-characters-here
ADMIN_PASSWORD_HASH=generate-with-werkzeug-security
CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SOURCE_ALIAS=motoclube-admin
NETWORK=testnet
COOKIE_SECURE=false
